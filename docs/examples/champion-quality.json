{
  "observatory": {
    "subjectSelector": ["proxy-"],
    "probeURL": "http://healthcheck.internal/health",
    "probeInterval": "5s",
    "enableConcurrency": true
  },
  "routing": {
    "balancers": [
      {
        "tag": "auto_proxy",
        "selector": ["proxy-"],
        "strategy": {
          "type": "champion",
          "settings": {
            "qualityMode": "select",
            "preferredTag": "proxy-hk",
            "candidateObservationCount": 4,
            "preferredObservationCount": 6,
            "healthPingJitterScale": 1
          }
        }
      }
    ],
    "rules": [
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "auto_proxy"
      }
    ]
  }
}
